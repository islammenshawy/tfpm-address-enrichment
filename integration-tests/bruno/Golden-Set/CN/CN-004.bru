meta {
  name: CN-004 — CN
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/api/v1/enrich
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: bruno-CN-004
}

body:json {
  {
    "rawAddress": "Room 3208, Shenzhen International Trade Center, 160 Fuhua Yi Lu, Futian Qu, Shenzhen, Guangdong, 518048, China"
  }
}

assert {
  res.status: eq 200
  res.body.outcome: isString
  res.body.fields: isDefined
  res.body.overallConfidence: isNumber
}

tests {
  test("CN-004 — expected fields match golden set", function() {
    const body = res.getBody();
    expect(body.outcome).to.be.oneOf(["SUCCESS", "REQUIRES_REVIEW", "UNSTRUCTURABLE"]);
    expect(body.recommendation).to.be.oneOf(["AutoApproved", "ManualReview"]);
    expect(body.overallConfidence).to.be.a("number");
    expect(body.sources).to.be.an("array");
    const actual_CTRY = (body.fields.CTRY?.value || "").toLowerCase();
    expect(actual_CTRY).to.eq("cn");
    const actual_TWN_NM = (body.fields.TWN_NM?.value || "").toLowerCase();
    expect(actual_TWN_NM).to.eq("shenzhen");
    const actual_PST_CD = (body.fields.PST_CD?.value || "").toLowerCase();
    expect(actual_PST_CD).to.eq("518048");
    const actual_CTRY_SUB_DVSN = (body.fields.CTRY_SUB_DVSN?.value || "").toLowerCase();
    expect(actual_CTRY_SUB_DVSN).to.eq("futian");
    const actual_STRT_NM = (body.fields.STRT_NM?.value || "").toLowerCase();
    expect(actual_STRT_NM).to.eq("fuhua yi lu");
    const actual_BLDG_NB = (body.fields.BLDG_NB?.value || "").toLowerCase();
    expect(actual_BLDG_NB).to.eq("160");
    const actual_BLDG_NM = (body.fields.BLDG_NM?.value || "").toLowerCase();
    expect(actual_BLDG_NM).to.eq("shenzhen international trade center");
    const actual_ADR_LINE = (body.fields.ADR_LINE?.value || "").toLowerCase();
    expect(actual_ADR_LINE).to.eq("room 3208, shenzhen international trade center");
  });
}
