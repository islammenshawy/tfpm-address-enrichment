meta {
  name: DE-007 — DE
  type: http
  seq: 52
}

post {
  url: {{baseUrl}}/api/v1/enrich
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: bruno-DE-007
}

body:json {
  {
    "rawAddress": "Helaba Landesbank, Neue Mainzer Str. 52-58, 60311 Frankfurt am Main",
    "countryHint": "DE",
    "locale": "de-DE"
  }
}

assert {
  res.status: eq 200
  res.body.outcome: isString
  res.body.fields: isDefined
  res.body.overallConfidence: isNumber
}

tests {
  test("DE-007 — expected fields match golden set", function() {
    const body = res.getBody();
    expect(body.outcome).to.be.oneOf(["SUCCESS", "REQUIRES_REVIEW", "UNSTRUCTURABLE"]);
    const actual_CTRY = (body.fields.CTRY?.value || "").toLowerCase();
    expect(actual_CTRY).to.eq("de");
    const actual_TWN_NM = (body.fields.TWN_NM?.value || "").toLowerCase();
    expect(actual_TWN_NM).to.eq("frankfurt am main");
    const actual_PST_CD = (body.fields.PST_CD?.value || "").toLowerCase();
    expect(actual_PST_CD).to.eq("60311");
    const actual_STRT_NM = (body.fields.STRT_NM?.value || "").toLowerCase();
    expect(actual_STRT_NM).to.eq("neue mainzer str.");
    const actual_BLDG_NB = (body.fields.BLDG_NB?.value || "").toLowerCase();
    expect(actual_BLDG_NB).to.eq("52-58");
  });
}
