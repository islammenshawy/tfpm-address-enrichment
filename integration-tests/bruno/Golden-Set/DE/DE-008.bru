meta {
  name: DE-008 — DE
  type: http
  seq: 53
}

post {
  url: {{baseUrl}}/api/v1/enrich
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: bruno-DE-008
}

body:json {
  {
    "rawAddress": "c/o Kanzlei Weber und Partner, Friedrichstra\u00dfe 95, 10117 Berlin",
    "countryHint": "DE",
    "locale": "de-DE"
  }
}

assert {
  res.status: eq 200
  res.body.outcome: isString
  res.body.fields: isDefined
  res.body.overallConfidence: isNumber
}

tests {
  test("DE-008 — expected fields match golden set", function() {
    const body = res.getBody();
    expect(body.outcome).to.be.oneOf(["SUCCESS", "REQUIRES_REVIEW", "UNSTRUCTURABLE"]);
    const actual_CTRY = (body.fields.CTRY?.value || "").toLowerCase();
    expect(actual_CTRY).to.eq("de");
    const actual_TWN_NM = (body.fields.TWN_NM?.value || "").toLowerCase();
    expect(actual_TWN_NM).to.eq("berlin");
    const actual_PST_CD = (body.fields.PST_CD?.value || "").toLowerCase();
    expect(actual_PST_CD).to.eq("10117");
    const actual_STRT_NM = (body.fields.STRT_NM?.value || "").toLowerCase();
    expect(actual_STRT_NM).to.eq("friedrichstraße");
    const actual_BLDG_NB = (body.fields.BLDG_NB?.value || "").toLowerCase();
    expect(actual_BLDG_NB).to.eq("95");
    const actual_ADR_LINE = (body.fields.ADR_LINE?.value || "").toLowerCase();
    expect(actual_ADR_LINE).to.eq("kanzlei weber und partner");
  });
}
