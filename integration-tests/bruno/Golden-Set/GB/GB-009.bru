meta {
  name: GB-009 — GB
  type: http
  seq: 69
}

post {
  url: {{baseUrl}}/api/v1/enrich
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: bruno-GB-009
}

body:json {
  {
    "rawAddress": "Principality Building Society, Principality House, Queen Street, Cardiff CF10 1UA",
    "countryHint": "GB",
    "locale": "en-GB"
  }
}

assert {
  res.status: eq 200
  res.body.outcome: isString
  res.body.fields: isDefined
  res.body.overallConfidence: isNumber
}

tests {
  test("GB-009 — expected fields match golden set", function() {
    const body = res.getBody();
    expect(body.outcome).to.be.oneOf(["SUCCESS", "REQUIRES_REVIEW", "UNSTRUCTURABLE"]);
    const actual_CTRY = (body.fields.CTRY?.value || "").toLowerCase();
    expect(actual_CTRY).to.eq("gb");
    const actual_TWN_NM = (body.fields.TWN_NM?.value || "").toLowerCase();
    expect(actual_TWN_NM).to.eq("cardiff");
    const actual_PST_CD = (body.fields.PST_CD?.value || "").toLowerCase();
    expect(actual_PST_CD).to.eq("cf10 1ua");
    const actual_STRT_NM = (body.fields.STRT_NM?.value || "").toLowerCase();
    expect(actual_STRT_NM).to.eq("queen street");
    const actual_BLDG_NM = (body.fields.BLDG_NM?.value || "").toLowerCase();
    expect(actual_BLDG_NM).to.eq("principality house");
  });
}
