meta {
  name: HK-002 — HK
  type: http
  seq: 77
}

post {
  url: {{baseUrl}}/api/v1/enrich
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Correlation-Id: bruno-HK-002
}

body:json {
  {
    "rawAddress": "Unit 1205, 12/F, Miramar Tower, 132 Nathan Road, Tsim Sha Tsui, Kowloon, Hong Kong"
  }
}

assert {
  res.status: eq 200
  res.body.outcome: isString
  res.body.fields: isDefined
  res.body.overallConfidence: isNumber
}

tests {
  test("HK-002 — expected fields match golden set", function() {
    const body = res.getBody();
    expect(body.outcome).to.be.oneOf(["SUCCESS", "REQUIRES_REVIEW", "UNSTRUCTURABLE"]);
    expect(body.recommendation).to.be.oneOf(["AutoApproved", "ManualReview"]);
    expect(body.overallConfidence).to.be.a("number");
    expect(body.sources).to.be.an("array");
    const actual_CTRY = (body.fields.CTRY?.value || "").toLowerCase();
    expect(actual_CTRY).to.eq("hk");
    const actual_TWN_NM = (body.fields.TWN_NM?.value || "").toLowerCase();
    expect(actual_TWN_NM).to.eq("kowloon");
    const actual_STRT_NM = (body.fields.STRT_NM?.value || "").toLowerCase();
    expect(actual_STRT_NM).to.eq("nathan road");
    const actual_BLDG_NB = (body.fields.BLDG_NB?.value || "").toLowerCase();
    expect(actual_BLDG_NB).to.eq("132");
    const actual_BLDG_NM = (body.fields.BLDG_NM?.value || "").toLowerCase();
    expect(actual_BLDG_NM).to.eq("miramar tower");
    const actual_ADR_LINE = (body.fields.ADR_LINE?.value || "").toLowerCase();
    expect(actual_ADR_LINE).to.eq("unit 1205, 12/f, miramar tower");
    const actual_CTRY_SUB_DVSN = (body.fields.CTRY_SUB_DVSN?.value || "").toLowerCase();
    expect(actual_CTRY_SUB_DVSN).to.eq("tsim sha tsui");
  });
}
